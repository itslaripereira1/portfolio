// Site da Larissa Pereira publicado como Worker na Cloudflare.
{
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  // Só os vídeos passam pelo worker.js (para tocarem no iPhone); o resto do site vai direto.
  "main": "worker.js",
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": ["/media/*"] },
  "workers_dev": true
}
